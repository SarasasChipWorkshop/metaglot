[Setup]
AppId=ExampleApp
AppName={cm:app_name}
AppVersion=1.0.0
AppVerName={cm:app_versioned_name,1.0.0}
DefaultDirName={autopf}\{cm:app_name}
OutputBaseFilename=example-setup
Compression=lzma
SolidCompression=yes

[Languages]
{% for lang in langs -%}
{%- if lang.is_official -%}
{%- if lang.lang == 'Default' -%}
{% assign base = 'compiler:Default.isl' -%}
{%- else -%}
{% assign base = 'compiler:Languages\' | append: lang.lang | append: '.isl' -%}
{%- endif -%}
Name: "{{ lang.name }}"; MessagesFile: "{{ base }},Strings\{{ lang.lang }}.isl"
{% else -%}
{%- comment -%}
unofficial or unmapped: dropped, since a Default.isl fallback would duplicate the English identity in the Select Language dialog
{%- endcomment -%}
{% endif -%}
{% endfor -%}
[Tasks]
Name: "desktopicon"; Description: "{cm:task_desktop_icon}"

[Files]
Source: "example.exe"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{autodesktop}\{cm:app_name}"; Filename: "{app}\example.exe"; Tasks: desktopicon
